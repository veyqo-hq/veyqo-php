{
    "name": "veyqo/veyqo-php",
    "description": "Official PHP library for the Veyqo payments API: payments, checkout, refunds, subscriptions and webhook verification.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "veyqo",
        "payments",
        "paystack",
        "flutterwave",
        "nigeria",
        "subscriptions",
        "webhooks"
    ],
    "homepage": "https://veyqo.org/docs",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Veyqo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Veyqo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "support": {
        "issues": "https://github.com/coder-frank/veyqo-php/issues",
        "source": "https://github.com/coder-frank/veyqo-php"
    }
}
